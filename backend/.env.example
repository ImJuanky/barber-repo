# Servidor
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# Base de datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=peluqueria
DB_USER=peluqueria_user
DB_PASSWORD=change_me
# Pon DB_SSL=true si tu proveedor de MySQL exige conexión cifrada (ej. Aiven)
DB_SSL=false

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h

# Admin inicial (usado solo por el script de seed)
ADMIN_EMAIL=admin@peluqueria.com
ADMIN_PASSWORD=ChangeMe123!

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Notificaciones WhatsApp al admin (via CallMeBot, ver README)
WHATSAPP_ADMIN_PHONE=34625304333
WHATSAPP_API_KEY=

# Notificaciones push al admin (via ntfy.sh, gratis y oficial, ver README)
NTFY_TOPIC=
